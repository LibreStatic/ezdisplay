about = Desktop stand-in for the Android client.
usage-label = Usage:
heading-commands = Commands
heading-options = Options
help-flag = Print help
version-flag = Print version
arg-connect = Host address (e.g. the `adb reverse` endpoint on a device is `127.0.0.1:27183`).
arg-width = Fake display width.
arg-height = Fake display height.
arg-refresh-rates-mhz = Fake display refresh rates in millihertz, comma separated.
arg-frames = Exit after this many decoded frames.
arg-dump-frame = Write the Nth decoded frame (1-based) to a PPM file: `--dump-frame 100 out.ppm`.
arg-name = Device name sent in Hello.
arg-no-verify = Do not interpret frames as the synthetic test pattern.
arg-connect-timeout = Keep retrying the TCP connection for this many seconds.
arg-max-seconds = Abort after this many seconds.
arg-input-script = Play a canned input sequence once, starting at the first video frame: tap, drag, circle, touch2, scroll, or keys (Ctrl+Space held during a pen stroke; needs a host with KEYS).
arg-exit-after-script = Exit shortly after the input script finished.
arg-audio = Advertise PC audio playback: the host streams its audio and the packets are counted (not played).
arg-codec = Codec to ask the host for: auto, h264, hevc or av1. The host uses it only if both sides support it.
arg-quality = Quality to ask the host for: normal, high or lossless. The host honours high and lossless only on a USB link; lossless needs HEVC.

err-dump-frame = --dump-frame N must be a number
err-connecting = connecting to { $addr }

summary-stream = stream: { $width }x{ $height } @ { $hz } Hz { $codec } { $kbps } kbps via { $encoder }
summary-end = end: { $end }
summary-video = video: received { $received } decoded { $decoded } dropped { $dropped } keyframes { $keyframes } codec-configs { $configs } ({ $bytes } bytes)
summary-cursor = cursor: shapes { $shapes } states { $states } (missing shape: { $missing }) last { $last }
summary-clock = clock: offset { $offset } us, rtt { $rtt } us
summary-decode = decode: p50 { $p50 } us, p95 { $p95 } us
summary-e2e = e2e (host capture -> decoded): p50 { $p50 } us, p95 { $p95 } us
summary-input = input: status { $status }, options { $options }, sent { $sent }
summary-audio = audio: { $stream }, received { $packets } packets ({ $bytes } bytes)
summary-audio-off = off

arg-wifi = Connect to the host over Wi-Fi (QUIC) at ADDR instead of TCP. A paired host needs nothing else; the first time add `--pin` (or use `--uri`).
arg-pin = Pair with the host first, using the 6-digit PIN it shows.
arg-uri = Pairing URI from the host's QR code (`ezd://pair?...`): gives the address, pins the host fingerprint and carries the PIN.
arg-state-dir = Folder for this client's identity and the paired host (default: `ezdisplay-fake-client` in the config folder).
paired-with = Paired with { $host } ({ $fingerprint })
err-pin-needs-wifi = --pin needs --wifi ADDR or --uri
err-uri-invalid = the pairing URI is not valid
err-no-state-dir = cannot find a folder for the client state; pass --state-dir
err-wifi-no-address = no host address: pass --wifi ADDR or --uri
err-wifi-not-paired = not paired with a host yet: pass --pin PIN (or --uri) to pair
err-refused-not-paired = the host does not know this client: pair again with --pin
err-refused-closed = the host is not accepting new pairings: open its pairing window first
err-refused-attempts = the host closed pairing after too many wrong PINs
err-refused-wrong-pin = wrong PIN
err-refused-busy = the host is busy with another client
err-wifi-fingerprint = the host certificate does not match the paired one
err-wifi = Wi-Fi: { $reason }
