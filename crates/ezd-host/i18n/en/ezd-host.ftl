about = ezdisplay host: streams a virtual display to the tablet, plus diagnostics
cmd-run = Listen for a client and stream video to it.
cmd-diag = Print a JSON diagnostics report (failures are reported as data).
cmd-vdd = Manage the Virtual Display Driver (Windows).
usage-label = Usage:
heading-commands = Commands
heading-options = Options
help-flag = Print help
version-flag = Print version
run-source = Video source: "synthetic" is a software-generated test pattern with a moving cursor, "virtual" is a real virtual display captured and encoded by the platform backend.
run-listen = Address to listen on.
run-adb = Run `adb reverse tcp:27183 tcp:<listen port>` for SERIAL, or for every ready USB device when no serial is given; wireless devices need an explicit SERIAL. Kept up while the host runs and removed on exit.
run-aoa = USB without developer mode: "auto" switches a connected tablet to Android accessory mode and streams over USB, "off" leaves the USB devices alone. adb keeps working as the fallback.
run-link = Link kind: selects the default bitrate ceiling (usb 80 Mbps, network 30 Mbps).
run-max-refresh-mhz = Highest refresh rate to use, in millihertz.
run-bitrate-kbps = Fixed bitrate in kbit/s (clamped to the link ceiling).
run-encoder = Force a specific encoder by name.
run-adapter = GPU/adapter to use (`--source virtual`).
run-prefer-dgpu = Prefer the discrete GPU (`--source virtual`).
run-output = Capture this existing output instead of creating one (`--source virtual`).
run-scale = Stream at this fraction of the tablet's native resolution (0.25-1.0). Lower values reduce GPU load; the tablet scales the picture up.
run-video-window = Video frames that may be sent but not yet acknowledged by the tablet. 1 gives the lowest latency; more raises the frame rate when the round trip is long (Wi-Fi).
run-telemetry = Ask the tablet to show its telemetry overlay.
run-no-input = Do not inject input from the tablet.
run-pen-mode = How the pen is injected: "tablet" is a graphics tablet with pressure and tilt, "mouse" is an absolute mouse pointer.

vdd-status = Print the state of the VDD installation as JSON (changes nothing).
vdd-setup = One-time setup, run as administrator: lets normal users edit the VDD settings, optionally assigns the GPU and pre-adds modes, then reloads the driver.
vdd-setup-gpu = GPU the virtual display should render on (adapter name, as in `ezd-host diag`).
vdd-setup-mode = Mode to offer, `WIDTHxHEIGHT@HZ`; repeatable.
vdd-revert = Undo the permission change made by `setup`.
vdd-install = Install the bundled Virtual Display Driver (run as administrator; used by the installer).
vdd-install-driver-dir = Folder with the driver package and `nefconw.exe`.
vdd-uninstall = Remove the Virtual Display Driver installed by `install`; a driver installed by someone else is left alone (run as administrator).
vdd-uninstall-driver-dir = Folder with `nefconw.exe`; defaults to the folder recorded by `install`.
vdd-installed = The Virtual Display Driver is installed.
vdd-installed-reboot = The Virtual Display Driver is installed. Restart Windows to finish.
vdd-preexisting = A Virtual Display Driver installed by someone else was found; it was left untouched.
vdd-removed = The Virtual Display Driver was removed.
vdd-removed-reboot = The Virtual Display Driver was removed. Restart Windows to finish.
vdd-not-ours = The Virtual Display Driver was not installed by ezdisplay; it was left untouched.
vdd-err-not-elevated = Administrator rights are required: run this command from an elevated terminal.
vdd-err-failed = Virtual Display Driver: { $detail }

err-adb-not-found = adb was not found; install the Android platform-tools to use USB (the host keeps listening on the network)
err-adb-reverse = adb reverse for { $serial }: { $reason }
aoa-unavailable = USB without developer mode is unavailable ({ $reason }); USB debugging still works.
err-binding = binding { $addr }: { $reason }
err-scale-nan = `{ $value }` is not a number
err-scale-range = scale must be between 0.25 and 1.0, got { $value }
err-no-backend = no virtual display backend for this platform
err-source = could not create the video source: { $reason }

cmd-paired = List or forget the tablets paired over Wi-Fi.
paired-list = List the paired tablets.
paired-forget = Forget a paired tablet; it must pair again to stream.
paired-forget-target = Name of the tablet, or its fingerprint (all of it, or its first digits such as `3f2a-91c0`).
run-wifi = Also accept paired tablets over Wi-Fi (QUIC on UDP) on ADDR (default 0.0.0.0:27183). The first run shows a PIN and a QR code to pair a tablet.
run-pair = Open the pairing window at start even if a tablet is already paired (needs `--wifi`).

paired-none = No tablets are paired.
paired-never = never
paired-col-name = NAME
paired-col-fingerprint = FINGERPRINT
paired-col-paired = PAIRED (UTC)
paired-col-last-seen = LAST SEEN (UTC)
paired-forgot = Forgot { $name } ({ $fingerprint }).
pair-open = Pairing is open. On the tablet, scan this QR code or type the PIN:
pair-pin = PIN: { $pin }
pair-fingerprint = Host fingerprint: { $fingerprint }
pair-expires = Expires in { $seconds } s.
pair-done = Paired with { $device }.
pair-closed = Pairing is closed.
pair-closed-paired = Pairing is closed: a tablet paired.
pair-closed-attempts = Pairing is closed: too many wrong PINs.
pair-closed-expired = Pairing is closed: time ran out. Restart with `--pair` to pair again.
wifi-listening = Wi-Fi: listening on { $addr } (UDP). Host fingerprint: { $fingerprint }
wifi-firewall-hint = If tablets cannot connect, allow inbound UDP port { $port } in Windows Firewall (private networks).
wifi-firewall-hint-linux = A firewall is active. If tablets cannot connect, allow inbound UDP port { $port } (ufw or firewalld; see the Wi-Fi section of the README).
err-paired-not-found = no paired tablet matches `{ $query }`
err-paired-ambiguous = { $count } paired tablets match `{ $query }`; use more of the fingerprint
err-no-config-dir = cannot find the config folder
err-wifi = Wi-Fi: { $reason }
