<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Raw TCP to the adb-reversed host port on localhost, and QUIC (UDP) to paired hosts on Wi-Fi. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Wi-Fi discovery (NsdManager) and the multicast lock that keeps mDNS replies coming in. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- USB accessory (AOA) transport: optional, the app also works over adb and Wi-Fi without it. -->
    <uses-feature
        android:name="android.hardware.usb.accessory"
        android:required="false" />
    <!--
      Raising targetSdk to 37 will need android.permission.ACCESS_LOCAL_NETWORK (a runtime permission for
      reaching LAN hosts and for mDNS discovery). Not requested while targetSdk is 36.
    -->

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.EzDisplay">
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The PC host switched the tablet into accessory mode; a running instance gets it in onNewIntent. -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_ACCESSORY_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_ACCESSORY_ATTACHED"
                android:resource="@xml/accessory_filter" />
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>
        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="@string/settings_title"
            android:theme="@style/Theme.EzDisplay.Settings">
            <!-- The pairing QR code of the PC host (ezd://pair?...) opened from the system camera. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="ezd" android:host="pair" />
            </intent-filter>
        </activity>
        <activity
            android:name=".screensaver.ScreensaverPreviewActivity"
            android:exported="false"
            android:theme="@style/Theme.EzDisplay">
            <intent-filter>
                <action android:name="com.librestatic.ezdisplay.action.PREVIEW_SCREENSAVER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name=".onboarding.OnboardingActivity"
            android:exported="false"
            android:label="@string/onboarding_welcome_title"
            android:theme="@style/Theme.EzDisplay.Settings" />
    </application>
</manifest>
