    <string name="onboarding_welcome_title">Your tablet, a pen display</string>
    <string name="onboarding_welcome_body">ezdisplay turns your tablet into a pen display for your PC: a real second screen with pressure-sensitive pen input. Setup takes a minute.</string>
    <string name="onboarding_host_title">Install the PC app</string>
    <string name="onboarding_host_body">The tablet talks to a small app on your computer. It runs on Linux and Windows.</string>
    <string name="onboarding_host_linux_title">Linux</string>
    <string name="onboarding_host_linux_desc">KDE Plasma 6, GNOME, Sway or Hyprland on Wayland. Install the package for your distro (Arch, Debian, Ubuntu) or run the AppImage.</string>
    <string name="onboarding_host_windows_title">Windows</string>
    <string name="onboarding_host_windows_desc">Run the installer. It sets up the virtual display driver for you.</string>
    <string name="onboarding_host_download">Download</string>
    <string name="onboarding_host_run">Then start ezdisplay from your app launcher, or run this in a terminal:</string>
    <string name="onboarding_host_copy">Copy command</string>
    <string name="onboarding_connection_title">Choose how to connect</string>
    <string name="onboarding_connection_body">You can use either one whenever you like.</string>
    <string name="onboarding_connection_usb">USB cable</string>
    <string name="onboarding_connection_usb_desc">Plug the tablet into the PC with a USB cable and accept the prompt on the tablet. If Android asks which app should open the accessory, choose ezdisplay.</string>
    <string name="onboarding_connection_wifi">Wi-Fi</string>
    <string name="onboarding_connection_wifi_desc">Pair once with a PIN and the tablet finds the PC on its own next time. Both must be on the same network.</string>
    <string name="onboarding_pen_title">Pick your pen button</string>
    <string name="onboarding_pen_body">Choose what the button on your pen does.</string>
    <string name="onboarding_pen_later">You can change this later in Settings.</string>
    <string name="onboarding_display_title">Take care of your screen</string>
    <string name="onboarding_display_body">Keep long sessions easy on the screen.</string>
    <string name="onboarding_display_explain">After %1$s without touch, the screen dims to %2$d%% and small monitors, tablets and pens drift across it. After %3$s of that, it turns completely black.</string>
    <string name="onboarding_display_explain_never">After %1$s without touch, the screen dims to %2$d%% and small monitors, tablets and pens drift across it. It never turns completely black.</string>
    <string name="onboarding_display_gesture">Swipe down from the top edge while connected to open the input settings.</string>
    <string name="onboarding_done_title">You are all set</string>
    <string name="onboarding_done_body">Connect your tablet to the PC and start drawing. You can open this guide again from Settings.</string>
