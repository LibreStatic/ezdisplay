    <string name="onboarding_welcome_title">Votre tablette, un écran à stylet</string>
    <string name="onboarding_welcome_body">ezdisplay transforme votre tablette en écran à stylet pour votre PC : un vrai second écran avec un stylet sensible à la pression. La configuration prend une minute.</string>
    <string name="onboarding_host_title">Installez l’application du PC</string>
    <string name="onboarding_host_body">La tablette communique avec une petite application sur votre ordinateur. Elle fonctionne sous Linux et Windows.</string>
    <string name="onboarding_host_linux_title">Linux</string>
    <string name="onboarding_host_linux_desc">KDE Plasma 6, GNOME, Sway ou Hyprland sous Wayland. Installez le paquet de votre distribution (Arch, Debian, Ubuntu) ou lancez l’AppImage.</string>
    <string name="onboarding_host_windows_title">Windows</string>
    <string name="onboarding_host_windows_desc">Lancez l’installateur. Il configure le pilote d’écran virtuel pour vous.</string>
    <string name="onboarding_host_download">Télécharger</string>
    <string name="onboarding_host_run">Lancez ensuite ezdisplay depuis votre lanceur d’applications, ou exécutez ceci dans un terminal :</string>
    <string name="onboarding_host_copy">Copier la commande</string>
    <string name="onboarding_connection_title">Choisissez le mode de connexion</string>
    <string name="onboarding_connection_body">Vous pouvez utiliser l’un ou l’autre à tout moment.</string>
    <string name="onboarding_connection_usb">Câble USB</string>
    <string name="onboarding_connection_usb_desc">Branchez la tablette au PC avec un câble USB et acceptez la demande sur la tablette. Si Android demande quelle application doit ouvrir l’accessoire, choisissez ezdisplay.</string>
    <string name="onboarding_connection_wifi">Wi-Fi</string>
    <string name="onboarding_connection_wifi_desc">Associez-les une seule fois avec un code PIN et la tablette retrouvera le PC toute seule ensuite. Les deux doivent être sur le même réseau.</string>
    <string name="onboarding_pen_title">Choisissez le bouton du stylet</string>
    <string name="onboarding_pen_body">Choisissez ce que fait le bouton de votre stylet.</string>
    <string name="onboarding_pen_later">Vous pourrez le modifier plus tard dans les réglages.</string>
    <string name="onboarding_display_title">Ménagez votre écran</string>
    <string name="onboarding_display_body">Gardez un écran ménagé pendant les longues sessions.</string>
    <string name="onboarding_display_explain">Après %1$s sans toucher l’écran, la luminosité passe à %2$d%% et de petits écrans, tablettes et stylets le traversent. Après %3$s ainsi, l’écran devient complètement noir.</string>
    <string name="onboarding_display_explain_never">Après %1$s sans toucher l’écran, la luminosité passe à %2$d%% et de petits écrans, tablettes et stylets le traversent. L’écran ne devient jamais complètement noir.</string>
    <string name="onboarding_display_gesture">Balayez vers le bas depuis le bord supérieur pendant la connexion pour ouvrir les réglages de saisie.</string>
    <string name="onboarding_done_title">Tout est prêt</string>
    <string name="onboarding_done_body">Connectez votre tablette au PC et commencez à dessiner. Vous pouvez rouvrir ce guide depuis les réglages.</string>
