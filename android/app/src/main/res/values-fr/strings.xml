    <string name="section_video">Vidéo</string>
    <string name="video_codec_title">Codec vidéo</string>
    <string name="video_codec_auto">Automatique</string>
    <string name="video_codec_desc">Automatique choisit le meilleur codec pris en charge par cette tablette et par le PC. Les changements s\'appliquent à la prochaine connexion.</string>
    <string name="video_quality_title">Qualité via USB</string>
    <string name="video_quality_normal">Normale</string>
    <string name="video_quality_high">Élevée</string>
    <string name="video_quality_lossless">Sans perte</string>
    <string name="video_quality_desc">Élevée est une qualité fixe quasi sans perte et utilise plus de données. Sans perte utilise une qualité quasi sans perte tant que l\'image bouge, puis affiche l\'image exacte (sans perte, 4:2:0) un instant après son arrêt : le plus de données. Les deux ne s\'appliquent que via USB ; le Wi-Fi utilise toujours Normale.</string>
