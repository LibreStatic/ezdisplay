# Pinned third-party downloads of the AppImage build (sourced by build.sh).
# One group per file: NAME_URL, NAME_FILE (local file name) and NAME_SHA256. build.sh fails on any
# SHA-256 mismatch. Bumping a version means changing all three lines of its group.

# FFmpeg 8.1.3 source (built as shared libraries with --enable-gpl, so the result is GPL v2 or later).
FFMPEG_VERSION=8.1.3
FFMPEG_URL=https://ffmpeg.org/releases/ffmpeg-8.1.3.tar.xz
FFMPEG_FILE=ffmpeg-8.1.3.tar.xz
FFMPEG_SHA256=7138d28c96d9d3e3af4ee3d8cad72741f8ffb40da90c1112235dea3ecd3178a3

# x264 source (GPL v2 or later), the Debian orig tarball: byte-stable on snapshot.debian.org.
X264_VERSION=0.165.3223+git20250910.0480cb0
X264_URL=https://snapshot.debian.org/archive/debian/20260714T142842Z/pool/main/x/x264/x264_0.165.3223%2Bgit20250910.0480cb0.orig.tar.xz
X264_FILE=x264_0.165.3223+git20250910.0480cb0.orig.tar.xz
X264_SHA256=de68ca43d0c6e09baeb86a38ed5cde86b0a84a21d6babcc569804201dc9df133

# nv-codec-headers (MIT): headers FFmpeg uses to load NVENC and CUDA at run time. n12.1.14.1 is
# chosen over 13.x so NVENC keeps working with NVIDIA drivers 530 and later.
NVCODEC_VERSION=12.1.14.1
NVCODEC_URL=https://github.com/FFmpeg/nv-codec-headers/releases/download/n12.1.14.1/nv-codec-headers-12.1.14.1.tar.gz
NVCODEC_FILE=nv-codec-headers-12.1.14.1.tar.gz
NVCODEC_SHA256=043e46265517855f13bcb98b3a225b2761b2a83983b1645fa1d05876f1c3a781

# Vulkan-Headers (Apache-2.0 or MIT): headers only, FFmpeg 8.1 needs 1.3.277 or later and Ubuntu
# 24.04 ships 1.3.275.
VULKAN_VERSION=1.4.363.0
VULKAN_URL=https://github.com/KhronosGroup/Vulkan-Headers/archive/refs/tags/vulkan-sdk-1.4.363.0.tar.gz
VULKAN_FILE=Vulkan-Headers-vulkan-sdk-1.4.363.0.tar.gz
VULKAN_SHA256=4a078be12bef21cfebc09d878b77a63cff9d68f899254a0b00d0e37ef73e7f7e

# appimagetool (MIT): packs the AppDir into the AppImage (a build tool, not shipped).
APPIMAGETOOL_VERSION=1.9.1
APPIMAGETOOL_URL=https://github.com/AppImage/appimagetool/releases/download/1.9.1/appimagetool-x86_64.AppImage
APPIMAGETOOL_FILE=appimagetool-x86_64.AppImage
APPIMAGETOOL_SHA256=ed4ce84f0d9caff66f50bcca6ff6f35aae54ce8135408b3fa33abfc3cb384eb0

# type2-runtime (MIT): the static AppImage runtime, so the target machine does not need libfuse2.
RUNTIME_VERSION=20251108
RUNTIME_URL=https://github.com/AppImage/type2-runtime/releases/download/20251108/runtime-x86_64
RUNTIME_FILE=runtime-x86_64
RUNTIME_SHA256=2fca8b443c92510f1483a883f60061ad09b46b978b2631c807cd873a47ec260d

# Android SDK Platform-Tools r37.0.1 for Linux (Apache-2.0, see its NOTICE.txt): the bundled adb,
# the same version as the Windows installer.
ADB_VERSION=37.0.1
ADB_URL=https://dl.google.com/android/repository/platform-tools_r37.0.1-linux.zip
ADB_FILE=platform-tools_r37.0.1-linux.zip
ADB_SHA256=d230f13842f60f782a8645f9c813f8f845bf36089ea7289f28c48f17979313f1
