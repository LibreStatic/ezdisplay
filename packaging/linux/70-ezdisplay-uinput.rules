# ezdisplay: let the logged-in user create uinput devices (touch, pen and pointer injection).
#
# Install:
#   sudo install -m644 packaging/linux/70-ezdisplay-uinput.rules /etc/udev/rules.d/
#   sudo udevadm control --reload && sudo udevadm trigger --name-match=uinput
#
# The file name must sort before 73-seat-late.rules, which applies the "uaccess" tag.
KERNEL=="uinput", SUBSYSTEM=="misc", OPTIONS+="static_node=uinput", TAG+="uaccess"
